# Copy this file to ".env" and fill in the blanks (no quotes, no spaces around "=").
# Firebase console > Project settings > General > Your apps > Web app (</>) > firebaseConfig
# Project I only needs Firebase Authentication, so API key, auth domain, project id and app id matter.
# After saving .env, ALWAYS restart with:  npx expo start -c
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=documate-v2.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=documate-v2
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
